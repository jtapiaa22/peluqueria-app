{
  "name": "peluqueria-app",
  "version": "3.0.2",
  "description": "Sistema de gestión para peluquería",
  "author": "Jorge Tapia Ahumada",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "publish": "vite build && npx electron-builder --win nsis --publish always",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.peluqueria.app",
    "productName": "PeluApp",
    "asar": true,
    "extraResources": [],
    "npmRebuild": true,
    "asarUnpack": [
      "node_modules/sql.js/**"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "publish": {
      "provider": "github",
      "owner": "jtapiaa22",
      "repo": "peluqueria-app",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PeluApp"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.1.7",
    "framer-motion": "^12.34.3",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.574.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "sql.js": "^1.14.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  }
}
